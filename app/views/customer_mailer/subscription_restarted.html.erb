<% if @subscription.is_installment_plan %>
  <%= header_section(t("mailers.customer.subscription_restarted.installment_subject")) %>
<% else %>
  <%= header_section(t("mailers.customer.subscription_restarted.subscription_subject")) %>
<% end %>
<div>
  <% if @subscription.is_installment_plan %>
    <% if @reason == Subscription::ResubscriptionReason::PAYMENT_ISSUE_RESOLVED %>
      <p><%= t("mailers.customer.subscription_restarted.body_installment_resolved", product: @subscription.link.name) %></p>
    <% else %>
      <p><%= t("mailers.customer.subscription_restarted.body_installment_manual", product: @subscription.link.name) %></p>
    <% end %>
  <% else %>
    <% if @reason == Subscription::ResubscriptionReason::PAYMENT_ISSUE_RESOLVED %>
      <p><%= t("mailers.customer.subscription_restarted.body_subscription_resolved_html", product: @subscription.link.name, link: link_to(t("common.here", default: "here"), @edit_card_url)).html_safe %></p>
    <% else %>
      <p><%= t("mailers.customer.subscription_restarted.body_subscription_manual", product: @subscription.link.name) %></p>
    <% end %>
  <% end %>
</div>
