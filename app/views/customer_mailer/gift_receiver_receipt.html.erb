<% charge_info = @receipt_presenter.charge_info %>
<div class="receipt">
  <div class="info-row">
    <span class="info-label"><%= t("mailers.customer.receipt.order_id") %>:</span>
    <span class="info-value"><%= charge_info.order_id %></span>
  </div>
  <div class="info-row with-top-margin">
    <span class="info-label"><%= t("mailers.customer.receipt.order_date") %>:</span>
    <span class="info-value"><%= charge_info.formatted_created_at %></span>
  </div>
</div>

<div>
  <h2><%= t("mailers.customer.receipt.gift_received_title") %></h2>

  <p><%= t("mailers.customer.auto_invoice.greeting") %>! <% if @chargeable.try(:gifter_hidden_from_recipient?) %><%= t("mailers.customer.receipt.gift_someone") %><% else %><%= mail_to(@chargeable.gifter_email) %><% end %> <%= t("mailers.customer.receipt.gift_received_body") %></p>

  <% if @chargeable.gift_note.present? %>
    <div>
      <div class="promo" role="status">
        <div>
          <table class="reset">
            <tr>
              <td>
                <%= image_tag("illustrations/gift.png", alt: "Gift") %>
              </td>
              <td>
                <%= @chargeable.gift_note %>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <% @receipt_presenter.items_infos.each do |item_info| %>
    <div class="item">
      <%= render("customer_mailer/receipt/item", item_info: item_info) %>
    </div>
  <% end %>

  <% if @receipt_presenter.giftee_manage_subscription.note.present? %>
    <p>
      <%= @receipt_presenter.giftee_manage_subscription.note %>
    </p>
  <% end %>

  <% if charge_info.product_questions_note.present? %>
    <div>
      <%= charge_info.product_questions_note %>
    </div>
  <% end %>
</div>

<%= render("customer_mailer/receipt/sections/shipping", receipt_presenter: @receipt_presenter) %>
