<div>
  <%= header_section t("mailers.customer.subscription_magic_link.header") %>
  <p><%= t("mailers.customer.subscription_magic_link.body", product: @subscription.link.name, hours: (Subscription::TOKEN_VALIDITY / 1.hour)) %></p>
  <%= link_to t("mailers.customer.subscription_magic_link.button"), manage_subscription_url(id: @subscription.external_id, token: @subscription.token, format: :html), class: "button primary" %>
</div>
<%= t("mailers.customer.subscription_magic_link.ignore_notice") %>
