<%= header_section(t("mailers.customer.preorder_receipt.subject", product: @product.name)) %>
<div>
  <% if @product.is_physical %>
    <p><%= t("mailers.customer.preorder_receipt.body_physical", product: @product.name, date: displayable_release_at_date_and_time(@product.preorder_link.release_at, @product.user.timezone)) %></p>
    <p><%= t("mailers.customer.preorder_receipt.contact_address_note") %></p>
    <p>
      <strong><%= t("mailers.customer.preorder_receipt.shipping_address") %></strong>
    </p>
    <p>
      <%= @shipping_info["full_name"] %>
      <br>
      <%= @shipping_info["street_address"] %>
      <br>
      <%= @shipping_info["city"] %>, <%= @shipping_info["state"] %> <%= @shipping_info["zip_code"] %>
      <br>
      <%= @shipping_info["country"] %>
    </p>
  <% else %>
    <p><%= t("mailers.customer.preorder_receipt.body_digital", product: @product.name, date: displayable_release_at_date_and_time(@product.preorder_link.release_at, @product.user.timezone)) %></p>
  <% end %>
</div>
