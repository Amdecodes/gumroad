<%= t("mailers.customer.partial_refund.header", refund_type: @refund_type) %>

<% if @formatted_presentment_refund_amount.present? && @formatted_usd_refund_amount.present? %>
<%= t("mailers.customer.partial_refund.body_presentment", refund_amount: @formatted_presentment_refund_amount, usd_refund_amount: @formatted_usd_refund_amount, purchase_amount: (@purchase.buyer_presentment? ? "#{@purchase.formatted_buyer_presentment_total} (#{@formatted_usd_total} USD)" : @purchase.formatted_total_transaction_amount), product: @purchase.link_name) %>
<% else %>
<%= t("mailers.customer.partial_refund.body", refund_amount: @formatted_refund_amount, purchase_amount: @purchase&.formatted_total_price || @purchase&.formatted_total_transaction_amount, product: @purchase.link_name) %>
<% end %>
