<% if @resource.suspended? %>
<%= t("devise.mailer.reset_password_instructions.denied_header") %>

<%= t("devise.mailer.reset_password_instructions.denied_p1") %>
<%= t("devise.mailer.reset_password_instructions.denied_p2") %>
<% else %>
<%= t("devise.mailer.reset_password_instructions.header") %>

<%= t("devise.mailer.reset_password_instructions.instruction") %>

<% url = edit_password_url(@resource, reset_password_token: @token) %>
<%= url %>

<%= t("devise.mailer.reset_password_instructions.ignore_notice") %>
<% end %>
