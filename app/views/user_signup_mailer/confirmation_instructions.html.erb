<%= header_section(t("devise.mailer.confirmation_instructions.header")) %>
<div>
  <p><%= t("devise.mailer.confirmation_instructions.instruction") %></p>
  <% url = confirmation_url(@resource, confirmation_token: @resource.confirmation_token) %>
  <p><%= link_to(t("devise.mailer.confirmation_instructions.action"), url, class: "button primary") %></p>
  <p><%= t("devise.mailer.confirmation_instructions.or_click") %> <%= link_to(url, url) %></p>
  <p><%= t("devise.mailer.confirmation_instructions.ignore_notice") %></p>
</div>
