<% if @resource.suspended? %>
  <%= header_section(t("devise.mailer.reset_password_instructions.denied_header")) %>
  <div>
    <p><%= t("devise.mailer.reset_password_instructions.denied_p1") %></p>
    <p><%= t("devise.mailer.reset_password_instructions.denied_p2") %></p>
  </div>
<% else %>
  <%= header_section(t("devise.mailer.reset_password_instructions.header")) %>
  <div>
    <p><%= t("devise.mailer.reset_password_instructions.instruction") %></p>
    <% url = edit_password_url(@resource, reset_password_token: @token) %>
    <p><%= link_to(t("devise.mailer.reset_password_instructions.action"), url, class: "button primary") %></p>
    <p><%= t("devise.mailer.reset_password_instructions.or_click") %> <%= link_to(url, url) %></p>
    <p><%= t("devise.mailer.reset_password_instructions.ignore_notice") %></p>
  </div>
<% end %>
