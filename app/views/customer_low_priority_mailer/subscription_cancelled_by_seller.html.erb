<% if @subscription.is_installment_plan %>
  <%= header_section(t("mailers.customer.subscription_cancelled_by_seller.installment_subject")) %>
<% else %>
  <%= header_section(t("mailers.customer.subscription_cancelled_by_seller.subscription_subject")) %>
<% end %>
<div>
  <% if @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_cancelled_by_seller.installment_body", product: @subscription.link.name) %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_cancelled_by_seller.subscription_body", product: @subscription.link.name, date: @subscription.formatted_end_time_of_subscription) %></p>
  <% end %>
</div>
