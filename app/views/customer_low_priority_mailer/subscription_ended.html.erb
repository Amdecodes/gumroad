<% if @subscription.is_installment_plan %>
  <%= header_section(t("mailers.customer.subscription_ended.installment_header")) %>
<% else %>
  <%= header_section(t("mailers.customer.subscription_ended.subscription_header")) %>
<% end %>
<div>
  <% if @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_ended.installment_body_1", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_ended.installment_body_2") %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_ended.subscription_body", product: @subscription.link.name) %></p>
  <% end %>
  <p><%= t("mailers.customer.subscription_ended.questions_contact_creator") %></p>
</div>
