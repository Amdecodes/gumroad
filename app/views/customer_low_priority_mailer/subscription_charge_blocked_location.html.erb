<%= header_section(@subject) %>
<div>
  <% why_declined_link = link_to(t("mailers.customer.subscription_charge_blocked_location.why_declined_link"), "https://gumroad.com/help/article/203-why-did-my-payment-fail#Not-available-in-your-location-Xr4mB") %>
  <% if @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_charge_blocked_location.installment_body_1", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_charge_blocked_location.installment_body_2_html", link: link_to(t("mailers.customer.subscription_charge_blocked_location.installment_update_link"), @edit_card_url)).html_safe %></p>
    <p><%= t("mailers.customer.subscription_charge_blocked_location.installment_body_3_html", product: @subscription.link.name, why_link: why_declined_link).html_safe %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_charge_blocked_location.subscription_body_1", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_charge_blocked_location.subscription_body_2_html", link: link_to(t("mailers.customer.subscription_charge_blocked_location.subscription_update_link"), @edit_card_url)).html_safe %></p>
    <p><%= t("mailers.customer.subscription_charge_blocked_location.subscription_body_3_html", product: @subscription.link.name, why_link: why_declined_link).html_safe %></p>
  <% end %>
</div>
