<% if @subscription.is_installment_plan %>
  <%= header_section(t("mailers.customer.subscription_charge_failed.installment_header")) %>
<% else %>
  <%= header_section(t("mailers.customer.subscription_charge_failed.header")) %>
<% end %>
<div>
  <% if @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_charge_failed.installment_body", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_charge_failed.installment_warning", product: @subscription.link.name) %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_charge_failed.subscription_body", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_charge_failed.subscription_warning", product: @subscription.link.name) %></p>
  <% end %>
</div>
