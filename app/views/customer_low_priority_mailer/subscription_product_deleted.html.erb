<% if @subscription.is_installment_plan %>
  <%= header_section(t("mailers.customer.subscription_product_deleted.installment_subject")) %>
<% else %>
  <%= header_section(t("mailers.customer.subscription_product_deleted.subscription_subject")) %>
<% end %>
<div>
  <% if @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_product_deleted.installment_body", product: @subscription.link.name) %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_product_deleted.subscription_body", product: @subscription.link.name) %></p>
  <% end %>
</div>
