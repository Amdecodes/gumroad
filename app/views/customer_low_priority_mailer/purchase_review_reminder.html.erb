<%= header_section(@title) %>
<div>
  <p><%= t("mailers.customer.purchase_review_reminder.body_greeting", name: (@purchaser_name.present? ? " #{@purchaser_name}" : "")) %>,</p>
  <p><%= t("mailers.customer.purchase_review_reminder.body_message", product: @product_name) %></p>
  <p><%= t("mailers.customer.purchase_review_reminder.thank_you") %></p>
  <a href="<%= @review_url %>" class="button primary">
    <%= t("mailers.customer.purchase_review_reminder.leave_review") %>
  </a>
</div>
