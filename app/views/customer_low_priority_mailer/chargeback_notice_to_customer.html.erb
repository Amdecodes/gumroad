<%= header_section(t("mailers.customer.chargeback_notice_to_customer.header")) %>
<div>
  <p>
    <% product_label = @disputable.multiple_purchases? ? t("mailers.customer.chargeback_notice_to_customer.disputed_items") : link_to(@disputable.purchase_for_dispute_evidence.link.name, @disputable.purchase_for_dispute_evidence.link.long_url) %>
    <%= t("mailers.customer.chargeback_notice_to_customer.body_1", product: product_label, amount: @disputable.formatted_disputed_amount, email: @disputable.customer_email).html_safe %>
    <% if @disputable.multiple_purchases? %>
      <% @disputable.disputed_purchases.each do |purchase| %>
        <p>
          <%= link_to purchase.link.name, purchase.link.long_url %>
        </p>
      <% end %>
    <% end %>
  </p>
  <p>
    <%= t("mailers.customer.chargeback_notice_to_customer.body_2") %>
  </p>
</div>
