<%= header_section(t("mailers.customer.blocked_purchase_resolved.header")) %>
<div>
  <% if @product.present? %>
    <p><%= t("mailers.customer.blocked_purchase_resolved.body_with_product_html", link: link_to(@product.name, @product.long_url)).html_safe %></p>
  <% else %>
    <p><%= t("mailers.customer.blocked_purchase_resolved.body_without_product") %></p>
  <% end %>
  <p><%= t("mailers.customer.blocked_purchase_resolved.body_reassurance") %></p>
</div>
