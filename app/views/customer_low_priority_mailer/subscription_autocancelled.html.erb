<% if @subscription.is_installment_plan %>
  <%= header_section(t("mailers.customer.subscription_autocancelled.installment_subject")) %>
<% else %>
  <%= header_section(t("mailers.customer.subscription_autocancelled.subscription_subject")) %>
<% end %>
<div>
  <% if @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_autocancelled.installment_body_1", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_autocancelled.installment_body_2_html", link: link_to(t("mailers.customer.subscription_autocancelled.update_payment_method_link"), manage_subscription_url(@subscription.external_id, token: @subscription.refresh_token))).html_safe %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_autocancelled.subscription_body_1", product: @subscription.link.name) %></p>
    <p><%= t("mailers.customer.subscription_autocancelled.subscription_body_2_html", link: link_to(t("common.here", default: "here"), @subscription.link.long_url)).html_safe %></p>
  <% end %>
</div>
