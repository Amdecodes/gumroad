<%= header_section(t("mailers.customer.credit_card_expiring_membership.header", product: @product.name)) %>

<div>
  <p><%= t("mailers.customer.credit_card_expiring_membership.greeting") %>,</p>
  <p><%= t("mailers.customer.credit_card_expiring_membership.body", last4: @last_4_digits_of_credit_card, month: @expiry_month_name, product: @product.name) %></p>
  <p><%= link_to t("mailers.customer.credit_card_expiring_membership.manage_button"), @edit_card_url, class: "button primary" %></p>

  <p><%= t("mailers.customer.credit_card_expiring_membership.or_click_here") %>: <%= link_to @edit_card_url, @edit_card_url %></p>

  <p><strong><%= t("mailers.customer.credit_card_expiring_membership.why_heading") %></strong></p>
  <p><%= t("mailers.customer.credit_card_expiring_membership.why_body") %></p>
</div>
