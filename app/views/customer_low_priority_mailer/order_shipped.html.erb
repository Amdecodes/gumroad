<%= header_section(t("mailers.customer.order_shipped.header")) %>
<div>
  <% if @tracking_link %>
    <p><%= t("mailers.customer.order_shipped.body_tracking", product: @product.name) %></p>
    <p>
      <%= link_to(@tracking_link[:label], @tracking_link[:url], class: "button primary") %>
      <% if @tracking_link[:host].present? %>
        <span><%= t("mailers.customer.order_shipped.destination", host: @tracking_link[:host]) %></span>
      <% end %>
    </p>
  <% else %>
    <p><%= t("mailers.customer.order_shipped.body_no_tracking", product: @product.name) %></p>
  <% end %>
  <p><%= t("mailers.customer.order_shipped.questions_reply") %></p>
</div>
