<% detail_style = "flex-grow:unset;flex:1;font-size:16px;" %>
<div>
  <p><%= t("mailers.customer.subscription_early_fraud_warning_notification.body_1", product: link_to(@product.name, @product.long_url), price: @price, date: @purchase_date, email: @purchase.email).html_safe %></p>
  <p><%= t("mailers.customer.subscription_early_fraud_warning_notification.body_2") %></p>
  <p><%= t("mailers.customer.subscription_early_fraud_warning_notification.body_manage_html", link: link_to(t("mailers.customer.receipt.subscription_settings", default: "subscription settings"), @edit_card_url)).html_safe %></p>
</div>
<div>
  <a class="button primary" href="<%= @edit_card_url %>"><%= t("actions.manage_membership", default: "Manage membership") %></a>
</div>
<div>
  <p><%= t("mailers.customer.receipt.questions_about_product.one") %></p>
  <p><%= t("mailers.customer.receipt.contact_seller_reply", seller: @subscription.link.user.display_name) %></p>
</div>
