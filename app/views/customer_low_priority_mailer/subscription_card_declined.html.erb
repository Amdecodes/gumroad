<%= header_section(@subject) %>
<div>
  <% if @payment_method_is_upi %>
    <p><%= t("mailers.customer.subscription_card_declined.upi_body_html", product: @subscription.link.name, link: link_to(t("mailers.customer.subscription_card_declined.update_payment_link"), @edit_card_url)).html_safe %></p>
    <p><%= t("mailers.customer.subscription_card_declined.upi_warning", product: @subscription.link.name) %></p>
  <% elsif @subscription.is_installment_plan %>
    <p><%= t("mailers.customer.subscription_card_declined.installment_body_html", product: @subscription.link.name, link: link_to(t("mailers.customer.subscription_card_declined.reauthorize_card_link"), @edit_card_url)).html_safe %></p>
    <p><%= t("mailers.customer.subscription_card_declined.installment_warning", product: @subscription.link.name) %></p>
  <% else %>
    <p><%= t("mailers.customer.subscription_card_declined.subscription_body_html", product: @subscription.link.name, link: link_to(t("mailers.customer.subscription_card_declined.reauthorize_card_link"), @edit_card_url)).html_safe %></p>
    <p><%= t("mailers.customer.subscription_card_declined.subscription_warning", product: @subscription.link.name) %></p>
  <% end %>
</div>
