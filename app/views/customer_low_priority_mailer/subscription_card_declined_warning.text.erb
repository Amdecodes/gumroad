<% if @charge_processor_id == "stripe_india" %>
<%= t("mailers.customer.subscription_card_declined_warning.upi_subject") %>
<%= strip_tags(t("mailers.customer.subscription_card_declined_warning.upi_reminder_html", product: @subscription.link.name, link: manage_subscription_url(id: @subscription.external_id))) %>
<%= t("mailers.customer.subscription_card_declined_warning.upi_reminder_warning", product: @subscription.link.name) %>
<% elsif @subscription.is_installment_plan %>
<%= t("mailers.customer.subscription_card_declined_warning.card_subject") %>
<%= strip_tags(t("mailers.customer.subscription_card_declined_warning.installment_reminder_html", product: @subscription.link.name, link: manage_subscription_url(id: @subscription.external_id))) %>
<%= t("mailers.customer.subscription_card_declined_warning.installment_reminder_warning", product: @subscription.link.name) %>
<% else %>
<%= t("mailers.customer.subscription_card_declined_warning.card_subject") %>
<%= strip_tags(t("mailers.customer.subscription_card_declined_warning.subscription_reminder_html", product: @subscription.link.name, link: manage_subscription_url(id: @subscription.external_id))) %>
<%= t("mailers.customer.subscription_card_declined_warning.subscription_reminder_warning", product: @subscription.link.name) %>
<% end %>
