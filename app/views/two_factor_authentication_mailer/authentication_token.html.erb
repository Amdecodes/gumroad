<%= header_section t("mailers.two_factor_authentication.authentication_token.header") %>
<div>
  <p><%= t("mailers.two_factor_authentication.authentication_token.instruction") %></p>
  <p>
    <strong>
      <%= simple_format @authentication_token %>
    </strong>
  </p>
  <p><%= t("mailers.two_factor_authentication.authentication_token.action_notice") %></p>
  <p><%= link_to t("mailers.two_factor_authentication.authentication_token.action"), verify_two_factor_authentication_url(token: @authentication_token, user_id: @user.encrypted_external_id, format: :html), class: "button primary" %></p>
  <p>
    <%= t("mailers.two_factor_authentication.authentication_token.expires_in", time: distance_of_time_in_words(TwoFactorAuthentication::TOKEN_VALIDITY)) %>
  </p>
</div>
